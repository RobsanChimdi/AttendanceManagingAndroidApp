# ==============================================================================
# EDUTRACK AI - Environment Configuration Example
# Copy this file to .env and configure appropriately. Do not commit actual secrets.
# ==============================================================================

# Server Configurations
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Security & Authentication
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=django-insecure-edutrackai-attendance-system-secret-key-temporary
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connections
# Format: postgresql+psycopg://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edutrack_db

# Facial Recognition Configurations
YUNET_MODEL_URL=https://github.com/opencv/opencv_zoo/raw/master/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
SFACE_MODEL_URL=https://github.com/opencv/opencv_zoo/raw/master/models/face_recognition_sface/face_recognition_sface_2021dec.onnx
FACE_MATCH_THRESHOLD=0.363

# Notification Service Configurations
ENABLE_NOTIFICATIONS=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
